# Cấu hình web Firebase (Project settings → General → Your apps → Web app → Config).
# Copy file này thành .env.local rồi điền giá trị. Đoạn cấu hình web được phép công khai.
# KHÔNG đặt service account (.json) hay token Telegram ở đây.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
